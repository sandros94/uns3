{
  "name": "uns3",
  "version": "0.1.0",
  "description": "Runtime agnostic S3 client.",
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": "sandros94/uns3",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./signer": {
      "types": "./dist/signer.d.mts",
      "default": "./dist/signer.mjs"
    },
    "./endpoint": {
      "types": "./dist/endpoint.d.mts",
      "default": "./dist/endpoint.mjs"
    },
    "./mime": {
      "types": "./dist/mime.d.mts",
      "default": "./dist/mime.mjs"
    },
    "./mime/*": {
      "types": "./dist/mime/*.d.mts",
      "default": "./dist/mime/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub && pnpm simple-git-hooks",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run --slowTestThreshold=1000 --project unit --project integration",
    "test:unit": "vitest run --slowTestThreshold=1000 --project unit",
    "test:integration": "vitest run --slowTestThreshold=1000 --project integration",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage --slowTestThreshold=1000 --project unit --project integration",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "automd": "^0.4.3",
    "nano-staged": "^1.0.2",
    "obuild": "^0.4.45",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "playwright": "^1.65.1",
    "simple-git-hooks": "^2.14.0",
    "testcontainers": "^12.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "resolutions": {
    "uns3": "link:."
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,json,yml,yaml,md}": [
      "pnpm run fmt"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.12 || >=24"
  },
  "packageManager": "pnpm@12.21.0"
}
